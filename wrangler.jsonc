{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "udder-chaos",
  "main": "hosting/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2026-11-10",
  "assets": { "directory": "frontend/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{"name":"ROOMS","class_name":"Room"},{"name":"DIRECTORY","class_name":"Directory"}] },
  "migrations": [{"tag":"v1","new_sqlite_classes":["Room","Directory"]}],
  "routes": [{"pattern":"udder-chaos.org","custom_domain":true}],
  "observability": {"enabled": false}
}
